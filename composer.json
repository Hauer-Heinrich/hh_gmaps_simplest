{
    "name": "hauerheinrich/hh-gmap-simplest",
    "type": "typo3-cms-extension",
    "description": "Hauer-Heinrich - Simple Google Maps TYPO3 extension.",
    "authors": [
        {
            "name": "Christian Hackl",
            "email": "chackl@hauer-heinrich.de",
            "homepage": "http://www.hauer-heinrich.de",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/Hauer-Heinrich/hh_gmaps_simplest/issues",
        "source": "https://github.com/Hauer-Heinrich/hh_gmaps_simplest",
        "docs": "https://github.com/Hauer-Heinrich/hh_gmaps_simplest/blob/master/README.md"
    },
    "funding": [
        {
            "type": "paypal",
            "url": "https://www.paypal.com/paypalme/hauerheinrich"
        }
    ],
    "version": "1.1.0",
    "license": ["GPL-2.0-or-later"],
    "keywords": ["TYPO3 CMS", "Google Maps", "Extension"],
    "replace": {
        "hauer-heinrich/hh_gmaps_simplest": "self.version",
        "typo3-ter/hh-gmap-simplest": "self.version"
    },
    "require": {
        "typo3/cms-core": "12.4.0-13.4.99",
        "typo3/cms-fluid": "12.4.0-13.4.99",
        "typo3/cms-frontend": "12.4.0-13.4.99",
        "typo3/cms-fluid-styled-content": "12.4.0-13.4.99"
    },
    "autoload": {
        "psr-4": {
            "HauerHeinrich\\HhSeo\\": "Classes"
        }
    },
    "extra": {
        "typo3/cms": {
            "cms-package-dir": "{$vendor-dir}/typo3/cms",
            "web-dir": ".Build/Web",
            "extension-key": "hh_gmaps_simplest"
        }
    }
}
